# Copie para .env (nao versionado) e ajuste. Todos os valores abaixo sao ficticios.
# Para docker-compose o .env fica na raiz; para rodar com mvnw direto, copie tambem para ProjectFlow-server/.env.

# Banco de dados MySQL
DB_USERNAME=projectflow
DB_PASSWORD=troque-esta-senha-do-banco
DB_ROOT_PASSWORD=troque-esta-senha-root
# Porta do servidor no host (docker compose)
SERVER_PORT=8080

# JWT: obrigatorio, minimo 64 caracteres (ex.: openssl rand -base64 64)
JWT_SECRET=troque-este-segredo-ficticio-por-um-valor-aleatorio-com-pelo-menos-64-caracteres

# CORS: origens permitidas, separadas por virgula (padrao: http://localhost:4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# URL do frontend usada nos links de e-mail
FRONTEND_BASE_URL=http://localhost:4200

# SMTP (opcional): se MAIL_HOST ficar vazio/ausente, os codigos e links de
# verificacao e recuperacao sao apenas registrados no log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
